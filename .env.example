# ==============================================================================
# RECITEWEB / CITEASSIST AI — PRODUCTION ENVIRONMENT SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION DOMAIN & DNS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://reciteweb.com
BETTER_AUTH_URL=https://reciteweb.com
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC AUTHENTICATION (32+ bytes cryptorandom string)
# ------------------------------------------------------------------------------
AUTH_SECRET=your_32_byte_hmac_sha256_signing_secret_here
BETTER_AUTH_SECRET=your_better_auth_encryption_secret_here

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY — DODO PAYMENTS (PCI-DSS Tier 1)
# ------------------------------------------------------------------------------
# Get your API Keys from: https://app.dodopayments.com/developers
DODO_PAYMENTS_API_KEY=live_your_dodo_payments_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_signing_secret_here
DODO_PRODUCT_PRO_ANNUAL=p_pro_annual_prod_id
DODO_PRODUCT_LAB_ANNUAL=p_lab_annual_prod_id

# ------------------------------------------------------------------------------
# 4. UPSTREAM AI INFERENCE & MULTI-VENDOR MINI LLM PRE-FLIGHT MESH
# ------------------------------------------------------------------------------
# Google AI Studio Primary (Free: 15 RPM, 1,500 RPD, 1M TPM)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Groq Cloud LPU (Free: 30 RPM, 14,400 RPD - Llama 3.2 3B / Llama 3.1 8B Instant)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cerebras Systems WSE-3 (Free: 30 RPM, 1M tokens/day - Llama 3.2 3B)
CEREBRAS_API_KEY=csk-your_cerebras_api_key_here

# GitHub Models Azure AI Gateway (Free via Personal Access Token - Phi-3.5-mini / gpt-4o-mini)
GITHUB_MODELS_TOKEN=ghp_your_github_token_here

# OpenRouter Free Pool (20 RPM - openrouter/auto:free)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Optional Heavy Reasoning Models
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_optional
OPENAI_API_KEY=sk-your_openai_api_key_optional
LLM_TIER_QUOTA_LIMIT=1000

# ------------------------------------------------------------------------------
# 5. OAUTH SOCIAL IDENTITY PROVIDERS (Better-Auth)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials (Redirect: /api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# GitHub Developer Settings OAuth Apps (Redirect: /api/auth/callback/github)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Microsoft Azure App Registrations (Redirect: /api/auth/callback/microsoft)
MICROSOFT_CLIENT_ID=your_microsoft_azure_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_azure_client_secret
