{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReciteAI",
  "version": "1.0.0",
  "identifier": "com.reciteai.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ReciteAI — Manuscript Citation Auditor",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",

        "connect-src": [
          "'self'",
          "https://api.anthropic.com",
          "https://api.openai.com",
          "https://generativelanguage.googleapis.com",
          "https://api.deepseek.com"
        ],

        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],

        "script-src": [
          "'self'",
          "'unsafe-inline'"
        ],

        "font-src": [
          "'self'",
          "data:"
        ],

        "img-src": [
          "'self'",
          "data:",
          "blob:"
        ],

        "object-src": "'none'",
        "base-uri":   "'none'",
        "form-action": "'none'",

        "frame-ancestors": "'none'",

        "upgrade-insecure-requests": ""
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ReciteAI",
    "category": "Science",
    "shortDescription": "Manuscript Citation Auditor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "stronghold": {
      "passwordHashFunction": "argon2"
    }
  }
}
